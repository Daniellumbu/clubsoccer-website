rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone with a Firebase Auth account (created manually in the
    // Firebase Console — there is no public sign-up flow in this app)
    // is treated as an admin.
    function isAdmin() {
      return request.auth != null;
    }

    // Public site content — About & Donate page copy.
    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coaches
    match /coaches/{coachId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Schools (opponent directory: names, logos, locations)
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Schedules (one doc per season, contains a `games` array)
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Rosters (one doc per season, contains a `players` array)
    match /rosters/{rosterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Leadership / scoring leaders
    match /leadership/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
