rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Anyone with a Firebase Auth account (created manually in the
    // Firebase Console — there is no public sign-up flow in this app)
    // is treated as an admin.
    function isAdmin() {
      return request.auth != null;
    }

    function isValidImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Coach photos
    match /coaches/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // Leadership / scoring leader photos
    match /leaders/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // Player photos, grouped by roster/season
    match /players/{rosterId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
